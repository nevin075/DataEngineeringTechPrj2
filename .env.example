# Copy this file to .env and change the placeholder values:
#     copy .env.example .env      (Windows)
#     cp .env.example .env        (macOS / Linux)
# Never commit .env -- it is listed in .gitignore.

# ---- Container user (leave at 50000 on Windows / Docker Desktop) ----
AIRFLOW_UID=50000

# ---- PostgreSQL (one server, two databases: Airflow metadata + data warehouse) ----
POSTGRES_USER=data430
POSTGRES_PASSWORD=change_me_postgres
AIRFLOW_DB=airflow
WAREHOUSE_DB=retail_dw
# Host port for connecting from Windows tools (pgAdmin, DBeaver, psql).
# 5433 avoids clashing with a PostgreSQL you may already have installed on 5432 (Project 1).
POSTGRES_HOST_PORT=5433

# ---- Airflow web UI login ----
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me_airflow
# Any long random string. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_SECRET_KEY=change_me_to_a_long_random_string
# Optional. Generate with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# ---- Spark cluster sizing (fits Docker Desktop's default ~8 GB on a 16 GB PC) ----
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g
SPARK_DRIVER_MEMORY=1g
SPARK_EXECUTOR_MEMORY=1g
SPARK_TOTAL_EXECUTOR_CORES=2

# ---- Pipeline settings ----
PIPELINE_RECORDS=100000
PIPELINE_SEED=42

# ---- Optional failure alerting (bonus). Leave blank to only log alerts. ----
# Slack incoming-webhook URL, e.g. https://hooks.slack.com/services/XXX/YYY/ZZZ
SLACK_WEBHOOK_URL=
# Email alerts need SMTP settings; leave ALERT_EMAIL blank to disable.
ALERT_EMAIL=
AIRFLOW__SMTP__SMTP_HOST=
AIRFLOW__SMTP__SMTP_PORT=587
AIRFLOW__SMTP__SMTP_USER=
AIRFLOW__SMTP__SMTP_PASSWORD=
AIRFLOW__SMTP__SMTP_MAIL_FROM=

# ---- Jupyter (bonus notebook, only with: docker compose --profile notebook up) ----
JUPYTER_TOKEN=change_me_jupyter
